{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated learner preferences and display settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "preferredTheme": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 10
        },
        "targetLanguage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "proficiencyLevel": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "maxLength": 20
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "preferredTheme", "targetLanguage", "proficiencyLevel", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing the user's verified email.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 320
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Multi-turn Nimo conversation thread owned by a single user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "modelMode": {
          "type": "string",
          "enum": ["fast", "balanced", "thinking", "vision"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "modelMode", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Single message inside a Nimo chat thread.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "maxLength": 20
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25000
        },
        "modelUsed": {
          "type": "string",
          "maxLength": 64
        },
        "hasImage": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "threadId", "role", "content", "modelUsed", "hasImage", "createdAt"]
    },
    "VocabItem": {
      "title": "VocabItem",
      "description": "Saved language vocabulary card with phonetic guide and example sentence.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "level": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "maxLength": 20
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "translation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "phonetic": {
          "type": "string",
          "maxLength": 200
        },
        "exampleSentence": {
          "type": "string",
          "maxLength": 400
        },
        "exampleTranslation": {
          "type": "string",
          "maxLength": 400
        },
        "mastered": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "language", "level", "term", "translation", "phonetic", "exampleSentence", "exampleTranslation", "mastered", "createdAt"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "AI-generated subject study summary saved by the learner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summaryMarkdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "subject", "title", "summaryMarkdown", "createdAt"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Completed quiz record with score and summary.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "difficulty": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "maxLength": 20
        },
        "score": {
          "type": "integer"
        },
        "totalQuestions": {
          "type": "integer"
        },
        "summaryText": {
          "type": "string",
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "topic", "difficulty", "score", "totalQuestions", "summaryText", "createdAt"]
    },
    "CodeSnippet": {
      "title": "CodeSnippet",
      "description": "Saved coding workbench file and execution output.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "code": {
          "type": "string",
          "maxLength": 40000
        },
        "lastOutput": {
          "type": "string",
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "language", "code", "lastOutput", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User preferences and display profile isolated to owner."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document for user email."
    },
    "/chatThreads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "User-owned multi-turn Nimo chat threads."
    },
    "/chatThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a chat thread."
    },
    "/vocabItems/{itemId}": {
      "schema": { "$ref": "#/entities/VocabItem" },
      "description": "Saved language learning vocabulary items."
    },
    "/studyNotes/{noteId}": {
      "schema": { "$ref": "#/entities/StudyNote" },
      "description": "Saved general learning study guides and summaries."
    },
    "/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Completed quiz attempt scores and topic summaries."
    },
    "/codeSnippets/{snippetId}": {
      "schema": { "$ref": "#/entities/CodeSnippet" },
      "description": "Saved code workbench snippets."
    }
  }
}
