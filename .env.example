# ==============================================================================
# Nimo — Environment Variables Template
# Copy to .env for local development. Never commit .env or secret keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server-Side Audio & Live Voice (Express Backend Only — Never Client-Exposed)
# ------------------------------------------------------------------------------
# Server-only secret used in server.ts / AI Studio Secrets for:
#   - Speech-to-Text (/api/audio/transcribe -> gemini-3.5-transcribe)
#   - Text-to-Speech (/api/audio/tts -> gemini-3.8-flash-tts)
#   - Pronunciation Coaching (/api/learn/language) & Live Voice (/ws/live)
# IMPORTANT: Never expose this with a VITE_ prefix.
# Firebase AI Logic Hybrid Inference (Chat, Learn, Quiz, Create) runs via firebase/ai.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL where the server is hosted (injected automatically in Cloud Run / AI Studio)
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# Firebase App Check (Client-Side Public Attestation Keys)
# ------------------------------------------------------------------------------
# Public reCAPTCHA v3 site key registered in Firebase Console > App Check.
VITE_RECAPTCHA_SITE_KEY=""

# Optional alternative to VITE_RECAPTCHA_SITE_KEY for reCAPTCHA Enterprise.
# Set AT MOST ONE of VITE_RECAPTCHA_SITE_KEY or VITE_RECAPTCHA_ENTERPRISE_KEY (do not set both).
VITE_RECAPTCHA_ENTERPRISE_KEY=""

# Optional App Check debug token for local development (.env.local).
# In dev/localhost, App Check automatically runs in debug mode (`FIREBASE_APPCHECK_DEBUG_TOKEN = true`)
# when this is empty, printing a debug token UUID to your browser console. Register that UUID in:
#   Firebase Console -> App Check -> Apps -> (1:347676576464:web:96a145247bc2fdbab0acd5) -> Manage debug tokens
# Or paste the registered UUID below in .env.local to keep the same token across sessions.
# Never set this in production builds.
VITE_APPCHECK_DEBUG_TOKEN=

# ------------------------------------------------------------------------------
# Firebase AI Logic Hybrid Inference Configuration (Optional Override)
# ------------------------------------------------------------------------------
# Optional cloud fallback model override (defaults to gemini-3.5-flash-lite if unset).
VITE_HYBRID_CLOUD_MODEL="gemini-3.5-flash-lite"

